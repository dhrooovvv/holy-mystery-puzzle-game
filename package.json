{
  "name": "last-seen-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run source && vite build && node scripts/build-server.mjs",
    "build:reddit": "npm run source && REDDIT_BUILD=1 vite build --config vite.reddit.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/server/*.test.ts src/client/ryos/desktopContentBounds.test.ts src/client/puzzleInteractions.test.ts src/client/finderEntries.test.ts src/client/desktopShortcuts.test.ts",
    "login": "devvit login",
    "playtest": "devvit playtest",
    "deploy": "devvit upload",
    "watch:reddit": "npm run source && REDDIT_BUILD=1 vite build --watch --config vite.reddit.config.ts",
    "typecheck:reddit": "tsc --noEmit --project tsconfig.reddit-client.json && tsc --noEmit --project tsconfig.reddit.json",
    "source": "node scripts/package-source.mjs"
  },
  "dependencies": {
    "@hono/node-server": "https://registry.npmjs.org/@hono/node-server/-/node-server-2.1.5.tgz",
    "@radix-ui/react-menubar": "^1.1.16",
    "hono": "https://registry.npmjs.org/hono/-/hono-4.13.13.tgz",
    "motion": "^12.23.24",
    "react": "https://registry.npmjs.org/react/-/react-19.3.0.tgz",
    "react-dom": "https://registry.npmjs.org/react-dom/-/react-dom-19.3.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "https://registry.npmjs.org/@types/react/-/react-19.3.0.tgz",
    "@types/react-dom": "https://registry.npmjs.org/@types/react-dom/-/react-dom-19.3.0.tgz",
    "@vitejs/plugin-react": "https://registry.npmjs.org/@vitejs/plugin-react/-/plugin-react-6.1.1.tgz",
    "esbuild": "https://registry.npmjs.org/esbuild/-/esbuild-0.28.2.tgz",
    "typescript": "https://registry.npmjs.org/typescript/-/typescript-6.0.3.tgz",
    "vite": "https://registry.npmjs.org/vite/-/vite-8.3.0.tgz"
  },
  "optionalDependencies": {
    "@devvit/start": "0.15.4",
    "@devvit/web": "0.15.4",
    "devvit": "0.15.4"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "nanoid": "https://registry.npmjs.org/nanoid/-/nanoid-3.3.20.tgz",
    "source-map-js": "https://registry.npmjs.org/source-map-js/-/source-map-js-1.2.2.tgz",
    "rolldown": "https://registry.npmjs.org/rolldown/-/rolldown-1.2.8.tgz"
  },
  "license": "AGPL-3.0-only"
}
