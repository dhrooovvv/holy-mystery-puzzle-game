{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "last-seen-online",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "inline": true,
        "entry": "src/client/splash.html"
      },
      "game": {
        "entry": "src/client/index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "permissions": {
    "redis": true,
    "reddit": {
      "enable": true
    }
  },
  "menu": {
    "items": [
      {
        "label": "create last seen online case",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/post-create"
      }
    ]
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/install"
  },
  "scheduler": {
    "tasks": {
      "daily-case": {
        "endpoint": "/internal/cron/daily-case",
        "cron": "0 0 * * *"
      }
    }
  },
  "scripts": {
    "dev": "npm run watch:reddit",
    "build": "npm run build:reddit"
  }
}