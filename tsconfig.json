{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@devvit/web/client": [
        "./src/client/platform-local.ts"
      ]
    }
  },
  "include": [
    "src/client",
    "src/shared",
    "src/server/game.ts",
    "src/server/local.ts",
    "src/server/app.ts",
    "vite.config.ts"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}